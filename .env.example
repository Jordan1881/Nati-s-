# Auth
APP_PASSWORD=change-me-before-deploying
COOKIE_SECRET=replace-with-a-long-random-string

# Database (Supabase)
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Supabase Storage (for backup JSON exports)
SUPABASE_URL=https://[project].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Operational
ACTIVE_SALE_WEEKDAY=5

# Test database (separate Supabase project for tests)
TEST_DATABASE_URL=postgresql://postgres:[password]@[test-host]:5432/postgres
