{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "packages/frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/auth/(.*)", "dest": "/api/index.ts" },
    { "src": "/print/(.*)", "dest": "/api/index.ts" },
    { "src": "/health", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/packages/frontend/dist/$1" }
  ],
  "crons": [
    {
      "path": "/api/backup/run",
      "schedule": "0 20 * * 5"
    }
  ]
}
